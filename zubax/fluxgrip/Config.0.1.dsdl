# FluxGrip device configuration. The new configuration is persisted when the node is restarted.
# The Cyphal topic remap string is configured separately.

uint8 VERSION_VALID = 1
uint8 version

uint3 prio_feedback     # Message priority of the feedback topic. Lower values have higher priority.
void20
bool enable_second_can_interface

uint32 can_bitrate      # Nominal bitrate of all CAN interfaces [bit/s].

void64
void64
void64
void64

int32 flyback_period_ns       # PWM period [ns].
uint16[9] target_duty_cycle   # Target duty cycle for each bus-voltage bucket, scaled by 1e3.
uint16[9] min_duty_cycle       # Minimum duty cycle for each bus-voltage bucket, scaled by 1e3.
uint16[9] ramp_cap_voltage    # Capacitor voltage where the target duty is reached for each bucket [V].
int8[64] ds
# Do not alter unless advised by Zubax.

@extent 256 * 8
